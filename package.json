{
  "name": "lifes-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "ERP de gestion de stock professionnel",
  "author": "Life's Art ERP <sdrrakt@gmail.com>",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/lifesart/stock.git"
  },
  "bugs": {
    "url": "https://github.com/lifesart/stock/issues"
  },
  "homepage": "https://lifesart.com",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --host",
    "electron:dev": "NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --disable-gpu --disable-software-rasterizer --enable-features=UseOzonePlatform --ozone-platform=wayland\"",
    "electron:server": "node electron/server.cjs",
    "electron": "electron .",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron .",
    "preview": "vite preview",
    "lint": "oxlint",
    "clean": "rm -rf dist/ release/ node_modules/.vite dist-electron/ dist-final/",
    "clean:all": "rm -rf dist/ release/ dist-electron/ dist-final/ node_modules/",
    "build": "vite build --config vite.config.mjs",
    "build:tsc": "tsc -b && vite build",
    "build:skip": "vite build --emptyOutDir",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:win32": "npm run build && electron-builder --win --ia32 --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --x64 --config electron-builder.yml",
    "dist:linux-arm": "npm run build && electron-builder --linux --arm64 --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:mac-arm": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:all": "npm run build && electron-builder -mwl --config electron-builder.yml",
    "postinstall": "",
    "rebuild": "electron-rebuild -f"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.0",
    "speakeasy": "^2.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "terser": "^5.50.0",
    "typescript": "^5.8.2",
    "vite": "^8.1.0",
    "wait-on": "^9.1.0"
  }
}
